load("@prelude//rust:cargo_package.bzl", "DEFAULT_REINDEER_PLATFORMS", "set_reindeer_platforms")

# Maps buck2 target-platform constraints to the reindeer platform names
# declared in reindeer.toml, so third-party crate targets generated into
# buck/deps/rust/BUCK carry the right `cfg(...)`-gated deps per triple.
set_reindeer_platforms(select({
    "root//platforms:arm64e": "macos-arm64e",
    "root//platforms:kernel": "kernel-aarch64",
    "DEFAULT": DEFAULT_REINDEER_PLATFORMS,
}))
