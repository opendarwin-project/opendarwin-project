# Fully self-contained Mach-O executable (no LC_LOAD_DYLIB deps): statically
# links :libsystem + :iokit directly rather than against their shipped
# `.dylib` artifacts (see src/libsystem/BUCK, src/iokit/BUCK) - wild's
# Mach-O support is executable-only for now (no MH_DYLIB output), so this is
# the only linkable path today. Built for root//platforms:macos-arm64
# (toolchains/BUCK routes that to :cxx-darwin, which links with wild).
rust_binary(
    name = "hello",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    default_target_platform = "root//platforms:macos-arm64",
    edition = "2024",
    link_style = "static",
    deps = [
        "//src/iokit:iokit",
        "//src/libsystem:libsystem",
    ],
    visibility = ["PUBLIC"],
)
