# Freestanding aarch64-unknown-none kernel: no_std/no_main. Configured under
# `root//platforms:kernel-aarch64` (platforms/BUCK), which drives
# toolchains//:rust's select() onto the freestanding triple + `-Cpanic=abort`
# (see toolchains/BUCK) for this target *and* everything it transitively
# depends on, including third-party crates from buck/deps/rust/BUCK.
#
# Cargo's `[[bin]] name = "kernel"` implicitly links against the crate's own
# `lib.rs` (all entry asm / kmain / panic handler / allocator live there, per
# src/main.rs's `use kernel as _;`); buck2 has no such implicit same-package
# lib+bin linkage, so that's modeled explicitly as `kernel` depending on
# `:kernel-lib`.
rust_library(
    name = "kernel-lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate = "kernel",
    crate_root = "src/lib.rs",
    default_target_platform = "root//platforms:kernel-aarch64",
    edition = "2024",
    deps = [
        "//src/vfs:vfs",
        "deps//rust:aarch64-cpu",
        "deps//rust:aarch64-paging",
        "deps//rust:arm-gic",
        "deps//rust:lz4rip",
        "deps//rust:object",
        "deps//rust:safe-mmio",
        "deps//rust:spin",
        "deps//rust:virtio-drivers",
    ],
    visibility = ["PUBLIC"],
)

export_file(
    name = "linker_script",
    src = "boot/linker.ld",
    visibility = ["PUBLIC"],
)

rust_binary(
    name = "kernel",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    default_target_platform = "root//platforms:kernel-aarch64",
    edition = "2024",
    linker_flags = [
        "-Wl,-T,$(location :linker_script)",
    ],
    deps = [
        ":kernel-lib",
        "//src/loader:loader",
        "//src/vfs:vfs",
    ],
    visibility = ["PUBLIC"],
)
