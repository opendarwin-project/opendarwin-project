# The real crate output is a `cdylib` (System) meant for the Darwin userland
# targets built by tools/build_frameworks.sh with -Zbuild-std against
# aarch64-apple-darwin/arm64e-apple-darwin. This buck2 target builds the
# crate itself (an rlib) on the host platform, for use by other first-party
# crates and for `buck2 build`/typecheck coverage; it is not the shipped
# dylib.
rust_library(
    name = "libsystem",
    srcs = glob(["src/**/*.rs"]),
    crate = "System",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "deps//rust:spin",
    ],
    visibility = ["PUBLIC"],
)
